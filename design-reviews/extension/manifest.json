{
  "manifest_version": 3,
  "name": "Send to Design Reviews",
  "description": "Capture the page you're looking at and open it as a new screen in OtterlyAI Design Reviews.",
  "version": "1.0.0",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Send to Design Reviews",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
  },
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "permissions": ["activeTab", "tabs", "debugger", "storage"],
  "host_permissions": ["https://design-reviews.vercel.app/*", "http://localhost:3000/*"],
  "options_ui": { "page": "options.html", "open_in_tab": false }
}
